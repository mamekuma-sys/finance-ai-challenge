APP_ENV=development
DATABASE_URL=
PUBLIC_WEB_ORIGIN=http://localhost:3000
STORAGE_DIRECTORY=.rwa-guard-storage
# production 필수: p0-manifest.json과 required fixture가 있는 root
RWA_GUARD_FIXTURE_ROOT=
MAX_UPLOAD_BYTES=10485760
WORKER_NAME=rwa-guard-worker
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LOCK_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_FRESHNESS_SECONDS=30
ANTHROPIC_API_KEY=
DOCUMENT_EXTRACTOR=auto
ANTHROPIC_DOCUMENT_MODEL=claude-sonnet-4-20250514
KAIA_RPC_URL=
KAIA_FALLBACK_RPC_URL=
KAIA_CHAIN_ID=1001
SIMULATOR_SIGNER_PRIVATE_KEY=
SIMULATOR_CONTRACT_ALLOWLIST=
RWA_GUARD_FORGE_BIN=
OPERATOR_TOKEN=
OPERATOR_ID=
# 20자 이상이며 upper/lower/digit/symbol을 포함하는 단일 검토자 잠금 해제 코드
OPERATOR_ACCESS_CODE=
# 개발/테스트에서만 synthetic demo-operator를 허용합니다. production에서는 무시됩니다.
ALLOW_INSECURE_DEMO_OPERATOR=false
