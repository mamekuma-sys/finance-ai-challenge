NEXT_PUBLIC_API_BASE_URL=/backend-api
NEXT_PUBLIC_DEFAULT_EVIDENCE_MODE=REPLAY
BACKEND_API_BASE_URL=http://localhost:8000
PUBLIC_WEB_ORIGIN=http://localhost:3000
# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
BACKEND_OPERATOR_TOKEN=
# backend와 동일한 20자 이상 upper/lower/digit/symbol access code
OPERATOR_ACCESS_CODE=
# HMAC session/fingerprint 서명용 32자 이상 서버 전용 secret
OPERATOR_SESSION_SECRET=
# production에서 reverse proxy가 덮어쓰는 단일 client IP header 이름
TRUSTED_CLIENT_IP_HEADER=
# development/test loopback fallback을 명시적으로 허용할 때만 true
ALLOW_INSECURE_DEMO_OPERATOR=false
# production Node를 loopback HTTP로만 실행하는 로컬 Compose 전용. 실배포는 false.
ALLOW_INSECURE_LOCAL_SESSION=false
NEXT_PUBLIC_POLL_INTERVAL_MS=1500
NEXT_PUBLIC_POLL_MAX_ATTEMPTS=40
NEXT_PUBLIC_POLL_TIMEOUT_MS=60000
