# Shared
APP_ENV=production
DATABASE_URL=
# 로컬 HTTP Compose 기본값입니다.
PUBLIC_WEB_ORIGIN=http://localhost:3000
ALLOW_INSECURE_LOCAL_SESSION=true
# 외부 HTTPS 배포 예: PUBLIC_WEB_ORIGIN=https://guard.example
# 외부 HTTPS 배포에서는 ALLOW_INSECURE_LOCAL_SESSION=false
NEXT_PUBLIC_API_BASE_URL=/backend-api
BACKEND_API_BASE_URL=http://api:8000
RWA_GUARD_FIXTURE_ROOT=/opt/rwa-guard-fixtures
# Docker Compose에서 사용자가 강한 값으로 채워야 합니다.
POSTGRES_PASSWORD=

# Operator unlock — server only, never use NEXT_PUBLIC_ prefixes
OPERATOR_TOKEN=
OPERATOR_ID=
# 심사 공개 코드는 docs/submission/judging-access.md 참조. 운영값은 재사용하지 않는다.
OPERATOR_ACCESS_CODE=
OPERATOR_SESSION_SECRET=
WORKER_NAME=rwa-guard-worker
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LOCK_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_FRESHNESS_SECONDS=30
NEXT_PUBLIC_POLL_INTERVAL_MS=1500
NEXT_PUBLIC_POLL_MAX_ATTEMPTS=40
NEXT_PUBLIC_POLL_TIMEOUT_MS=60000

# AI — server only
ANTHROPIC_API_KEY=

# Supabase — server values are never exposed to the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kaia Kairos — P1 only
KAIA_RPC_URL=
KAIA_FALLBACK_RPC_URL=
KAIA_CHAIN_ID=1001
KAIA_EXPLORER_BASE_URL=https://kairos.kaiascan.io
SIMULATOR_SIGNER_PRIVATE_KEY=
SIMULATOR_CONTRACT_ALLOWLIST=

# Observability
SENTRY_DSN=
