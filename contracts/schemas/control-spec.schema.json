{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-guard.example.com/schemas/control-spec.schema.json",
  "title": "ControlSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "document_id",
    "constraint_id",
    "field",
    "value",
    "evidence_span"
  ],
  "properties": {
    "asset_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "constraint_id": { "type": "string", "minLength": 1 },
    "field": {
      "enum": [
        "max_supply",
        "issuer_role",
        "collateral_verified",
        "oracle_max_age",
        "price_band_breach",
        "pauser_role"
      ]
    },
    "value": { "type": ["string", "number", "integer", "boolean"] },
    "unit": { "type": ["string", "null"] },
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "start", "end", "quote"],
      "properties": {
        "document_id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "confirmed": { "type": "boolean" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "is_synthetic": { "const": true }
  }
}
