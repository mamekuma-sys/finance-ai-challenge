{
  "$defs": {
    "CodeFinding": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "code_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "deterministic_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Evidence",
          "type": "array"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "scan_id",
        "finding_id",
        "rule_id",
        "severity",
        "status",
        "title",
        "source_hash",
        "code_location"
      ],
      "title": "CodeFinding",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "ControlSpec": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence_span": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "asset_id",
        "document_id",
        "constraint_id",
        "field",
        "value",
        "evidence_span"
      ],
      "title": "ControlSpec",
      "type": "object"
    },
    "EvidenceMode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "NEEDS_REVIEW",
        "UNKNOWN"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "ImplementationStatus": {
      "enum": [
        "IMPLEMENTED",
        "PARTIAL",
        "MISSING",
        "UNKNOWN"
      ],
      "title": "ImplementationStatus",
      "type": "string"
    },
    "MismatchFinding": {
      "additionalProperties": false,
      "properties": {
        "mismatch_id": {
          "title": "Mismatch Id",
          "type": "string"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "implementation_status": {
          "$ref": "#/$defs/ImplementationStatus"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "evidence_links": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Links",
          "type": "array"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "mismatch_id",
        "constraint_id",
        "finding_id",
        "implementation_status",
        "severity",
        "evidence_links"
      ],
      "title": "MismatchFinding",
      "type": "object"
    },
    "OnchainEvidence": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/EvidenceMode"
        },
        "chain_id": {
          "title": "Chain Id",
          "type": "integer"
        },
        "tx_hash": {
          "title": "Tx Hash",
          "type": "string"
        },
        "log_index": {
          "minimum": 0,
          "title": "Log Index",
          "type": "integer"
        },
        "block_number": {
          "minimum": 0,
          "title": "Block Number",
          "type": "integer"
        },
        "event_name": {
          "title": "Event Name",
          "type": "string"
        },
        "previous_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Value"
        },
        "changed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Value"
        },
        "fixture_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Version"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "asset_id",
        "mode",
        "chain_id",
        "tx_hash",
        "log_index",
        "block_number",
        "event_name"
      ],
      "title": "OnchainEvidence",
      "type": "object"
    },
    "ScanRun": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScanStatus"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "rule_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rule Versions",
          "type": "object"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "scan_id",
        "asset_id",
        "status",
        "input_hashes",
        "rule_versions",
        "started_at"
      ],
      "title": "ScanRun",
      "type": "object"
    },
    "ScanStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "scan_run": {
      "$ref": "#/$defs/ScanRun"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlSpec"
      },
      "title": "Controls",
      "type": "array"
    },
    "code_findings": {
      "items": {
        "$ref": "#/$defs/CodeFinding"
      },
      "title": "Code Findings",
      "type": "array"
    },
    "mismatches": {
      "items": {
        "$ref": "#/$defs/MismatchFinding"
      },
      "title": "Mismatches",
      "type": "array"
    },
    "onchain_evidence": {
      "items": {
        "$ref": "#/$defs/OnchainEvidence"
      },
      "title": "Onchain Evidence",
      "type": "array"
    },
    "lineage": {
      "additionalProperties": true,
      "title": "Lineage",
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "is_synthetic": {
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "scan_run",
    "controls",
    "code_findings",
    "mismatches",
    "onchain_evidence",
    "lineage"
  ],
  "title": "EvidenceReport",
  "type": "object"
}
