{
  "$defs": {
    "FailedStage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "reason"
      ],
      "title": "FailedStage",
      "type": "object"
    },
    "ScanStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PARTIAL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failed_stages": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "failed_stages": {
      "items": {
        "$ref": "#/$defs/FailedStage"
      },
      "title": "Failed Stages",
      "type": "array"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "is_synthetic": {
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "rule_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Rule Versions",
      "type": "object"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ScanStatus"
    }
  },
  "required": [
    "scan_id",
    "asset_id",
    "status",
    "input_hashes",
    "rule_versions",
    "started_at"
  ],
  "title": "ScanRun",
  "type": "object"
}
