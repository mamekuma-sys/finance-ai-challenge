{
  "$defs": {
    "ScanStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ScanStatus"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "rule_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Rule Versions",
      "type": "object"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "is_synthetic": {
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "scan_id",
    "asset_id",
    "status",
    "input_hashes",
    "rule_versions",
    "started_at"
  ],
  "title": "ScanRun",
  "type": "object"
}
