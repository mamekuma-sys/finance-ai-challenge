{
  "$defs": {
    "CodeFinding": {
      "additionalProperties": false,
      "properties": {
        "code_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "deterministic_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Evidence",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        }
      },
      "required": [
        "scan_id",
        "finding_id",
        "rule_id",
        "severity",
        "status",
        "title",
        "source_hash",
        "code_location"
      ],
      "title": "CodeFinding",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "DiffChange": {
      "enum": [
        "RESOLVED",
        "REMAINS",
        "NEW"
      ],
      "title": "DiffChange",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "DOCUMENT",
        "CODE",
        "CHAIN"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "EvidenceMode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "FailedStage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "reason"
      ],
      "title": "FailedStage",
      "type": "object"
    },
    "FindingDiff": {
      "additionalProperties": false,
      "description": "Server-computed rescan comparison. Rule versions may differ between the two runs, so the\nconsumer cannot derive this by diffing two finding lists.",
      "properties": {
        "base_rule_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Rule Version"
        },
        "base_scan_id": {
          "title": "Base Scan Id",
          "type": "string"
        },
        "change": {
          "$ref": "#/$defs/DiffChange"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "head_rule_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Head Rule Version"
        },
        "head_scan_id": {
          "title": "Head Scan Id",
          "type": "string"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "change",
        "base_scan_id",
        "head_scan_id",
        "severity",
        "base_rule_version",
        "head_rule_version"
      ],
      "title": "FindingDiff",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "NEEDS_REVIEW",
        "UNKNOWN"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "ImplementationStatus": {
      "enum": [
        "IMPLEMENTED",
        "PARTIAL",
        "MISSING",
        "UNKNOWN"
      ],
      "title": "ImplementationStatus",
      "type": "string"
    },
    "MismatchFinding": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "evidence_links": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "DOCUMENT"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "CODE"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          ],
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "minItems": 2,
          "title": "Evidence Links",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "implementation_status": {
          "$ref": "#/$defs/ImplementationStatus"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "mismatch_id": {
          "title": "Mismatch Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "mismatch_id",
        "constraint_id",
        "finding_id",
        "implementation_status",
        "severity",
        "evidence_links"
      ],
      "title": "MismatchFinding",
      "type": "object"
    },
    "OnchainEvidence": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "block_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Hash"
        },
        "block_number": {
          "minimum": 0,
          "title": "Block Number",
          "type": "integer"
        },
        "chain_id": {
          "title": "Chain Id",
          "type": "integer"
        },
        "changed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Value"
        },
        "event_name": {
          "title": "Event Name",
          "type": "string"
        },
        "fixture_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Version"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "log_index": {
          "minimum": 0,
          "title": "Log Index",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/EvidenceMode"
        },
        "previous_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Value"
        },
        "receipt_status": {
          "anyOf": [
            {
              "const": "SUCCESS",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Status"
        },
        "tx_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Tx Hash",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        }
      },
      "required": [
        "asset_id",
        "mode",
        "chain_id",
        "tx_hash",
        "log_index",
        "block_number",
        "event_name"
      ],
      "title": "OnchainEvidence",
      "type": "object"
    },
    "ScanRun": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARTIAL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "failed_stages": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "failed_stages": {
          "items": {
            "$ref": "#/$defs/FailedStage"
          },
          "title": "Failed Stages",
          "type": "array"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "rule_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rule Versions",
          "type": "object"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScanStatus"
        }
      },
      "required": [
        "scan_id",
        "asset_id",
        "status",
        "input_hashes",
        "rule_versions",
        "started_at"
      ],
      "title": "ScanRun",
      "type": "object"
    },
    "ScanStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code_findings": {
      "items": {
        "$ref": "#/$defs/CodeFinding"
      },
      "title": "Code Findings",
      "type": "array"
    },
    "diff": {
      "items": {
        "$ref": "#/$defs/FindingDiff"
      },
      "title": "Diff",
      "type": "array"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "mismatches": {
      "items": {
        "$ref": "#/$defs/MismatchFinding"
      },
      "title": "Mismatches",
      "type": "array"
    },
    "onchain_evidence": {
      "items": {
        "$ref": "#/$defs/OnchainEvidence"
      },
      "title": "Onchain Evidence",
      "type": "array"
    },
    "report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Id"
    },
    "scan_run": {
      "$ref": "#/$defs/ScanRun"
    }
  },
  "required": [
    "scan_run"
  ],
  "title": "ScanResultResponse",
  "type": "object"
}
