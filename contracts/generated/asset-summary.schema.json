{
  "$defs": {
    "DataFreshness": {
      "description": "Derived from the current clock, so it never belongs on immutable evidence.",
      "enum": [
        "FRESH",
        "AGING",
        "STALE",
        "INVALID"
      ],
      "title": "DataFreshness",
      "type": "string"
    },
    "EvidenceMode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "ExploitRisk": {
      "additionalProperties": false,
      "description": "FR-06 Exploit Risk. 0~100이며 높을수록 위험하다. Security Score와 혼용하지 않는다.\n\n점수 계산은 컨트랙트 보안 트랙(C)이 수행하고 이 모델은 결과와 산정 근거를 노출한다.\n등급은 점수에서 파생되며, 확정 Critical이 있으면 최소 80점이라는 FR-06 규칙을\nvalidator가 강제한다.",
      "properties": {
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "contributors": {
          "items": {
            "$ref": "#/$defs/RiskContributor"
          },
          "title": "Contributors",
          "type": "array"
        },
        "floor_applied": {
          "default": false,
          "title": "Floor Applied",
          "type": "boolean"
        },
        "grade": {
          "$ref": "#/$defs/RiskGrade"
        },
        "has_confirmed_critical": {
          "default": false,
          "title": "Has Confirmed Critical",
          "type": "boolean"
        },
        "is_synthetic": {
          "const": true,
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "rule_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rule Versions",
          "type": "object"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "scan_id",
        "score",
        "grade",
        "calculated_at"
      ],
      "title": "ExploitRisk",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "NEEDS_REVIEW",
        "UNKNOWN"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "LatestScanRef": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScanStatus"
        }
      },
      "required": [
        "scan_id",
        "status"
      ],
      "title": "LatestScanRef",
      "type": "object"
    },
    "RiskContributor": {
      "additionalProperties": false,
      "description": "점수에 기여한 개별 발견사항. FR-06은 상위 기여 항목을 점수 옆에 표시하라고 요구한다.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contribution": {
          "minimum": 0.0,
          "title": "Contribution",
          "type": "number"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "weight": {
          "maximum": 40,
          "minimum": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "severity",
        "status",
        "weight",
        "confidence",
        "contribution"
      ],
      "title": "RiskContributor",
      "type": "object"
    },
    "RiskGrade": {
      "description": "PRD FR-06의 등급 경계. 점수에서 결정론적으로 파생되며 별도 판단이 들어가지 않는다.",
      "enum": [
        "LOW",
        "GUARDED",
        "ELEVATED",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskGrade",
      "type": "string"
    },
    "ScanStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Ledger row for the console home. The server aggregates so the list never ships findings.\n\nOptional fields are null before an asset has been scanned; the console renders its empty\nstate from that instead of showing a zero score.",
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "critical_count": {
      "default": 0,
      "minimum": 0,
      "title": "Critical Count",
      "type": "integer"
    },
    "evidence_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exploit_risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExploitRisk"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fixture_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Version"
    },
    "freshness": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataFreshness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "high_count": {
      "default": 0,
      "minimum": 0,
      "title": "High Count",
      "type": "integer"
    },
    "highest_severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "latest_scan": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatestScanRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "name"
  ],
  "title": "AssetSummary",
  "type": "object"
}
