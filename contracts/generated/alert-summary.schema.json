{
  "$defs": {
    "AlertStatus": {
      "enum": [
        "NEW",
        "ACKNOWLEDGED",
        "INVESTIGATING",
        "RESOLVED",
        "FALSE_POSITIVE"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "DOCUMENT",
        "CODE",
        "CHAIN"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "EvidenceMode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "alert_type": {
      "title": "Alert Type",
      "type": "string"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "asset_name": {
      "title": "Asset Name",
      "type": "string"
    },
    "cause": {
      "additionalProperties": true,
      "title": "Cause",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_links": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "evidence_mode": {
      "$ref": "#/$defs/EvidenceMode"
    },
    "fixture_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Version"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "memo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memo"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/AlertStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "alert_id",
    "asset_id",
    "asset_name",
    "alert_type",
    "severity",
    "status",
    "cause",
    "evidence_links",
    "evidence_mode",
    "created_at",
    "updated_at"
  ],
  "title": "AlertSummary",
  "type": "object"
}
