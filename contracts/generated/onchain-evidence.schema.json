{
  "$defs": {
    "EvidenceMode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "EvidenceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "block_number": {
      "minimum": 0,
      "title": "Block Number",
      "type": "integer"
    },
    "chain_id": {
      "title": "Chain Id",
      "type": "integer"
    },
    "changed_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changed Value"
    },
    "event_name": {
      "title": "Event Name",
      "type": "string"
    },
    "fixture_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Version"
    },
    "is_synthetic": {
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "log_index": {
      "minimum": 0,
      "title": "Log Index",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/EvidenceMode"
    },
    "previous_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Value"
    },
    "tx_hash": {
      "title": "Tx Hash",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "mode",
    "chain_id",
    "tx_hash",
    "log_index",
    "block_number",
    "event_name"
  ],
  "title": "OnchainEvidence",
  "type": "object"
}
